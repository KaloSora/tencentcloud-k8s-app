{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "${ARTIFACT_ID}",
    "namespace": "prod"
  },
  "spec": {
    "selector": {
      "app.kubernetes.io/name": "${ARTIFACT_ID}"
    },
    "ports": [
      {
        "name": "http",
        "port": 80,
        "targetPort": "http"
      }
    ],
    "type": "ClusterIP"
  }
}
